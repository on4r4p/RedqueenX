# Network namespace used for the browser crawler.
VPN_NETNS_NAME=redqueenx-vpn

# Host interface used to reach the internet before OpenVPN connects.
# Leave empty to auto-detect the default route interface.
VPN_HOST_IFACE=

# IPv4 subnet used between the host and the namespace.
VPN_NETNS_CIDR=10.200.0.0/24
VPN_NETNS_HOST_IP=10.200.0.1
VPN_NETNS_GUEST_IP=10.200.0.2

# OpenVPN server endpoint. Prefer an IP address to avoid pre-tunnel DNS.
VPN_REMOTE_HOST=
VPN_REMOTE_PORT=1194
VPN_REMOTE_PROTO=udp

# OpenVPN client config path. Provider .ovpn files and .conf copies are both valid.
VPN_CONFIG=./ops/vpn/custom.conf

# Prompt and start OpenVPN automatically when run.sh detects that the namespace/tunnel is missing.
VPN_NETNS_AUTOSTART=true

# Maximum time run.sh waits for the auto-started tunnel before refusing the command.
VPN_NETNS_AUTOSTART_TIMEOUT_SECONDS=90

# Log and PID files used when run.sh starts OpenVPN in the background.
VPN_NETNS_AUTOSTART_LOG=./runtime/netns-openvpn-autostart.log
VPN_NETNS_AUTOSTART_PID_FILE=./runtime/netns-openvpn-autostart.pid

# Compare namespace/browser IPv4 with the host public IPv4 detected before entering the namespace.
VPN_CHECK_HOST_IPV4_LEAK=true

# Run IPv6 leak checks. Keep true to detect IPv6 leaks by default.
VPN_CHECK_IPV6=true
