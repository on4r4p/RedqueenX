[
  {
    "id": "redqueenx-deploy",
    "execute-command": "/opt/redqueenx/ops/webhook/redqueenx-deploy.sh",
    "command-working-directory": "/opt/redqueenx",
    "response-message": "RedqueenX deploy started.\n",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "value",
            "value": "push",
            "parameter": {
              "source": "header",
              "name": "X-GitHub-Event"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "refs/heads/main",
            "parameter": {
              "source": "payload",
              "name": "ref"
            }
          }
        },
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "CHANGE_ME_GITHUB_WEBHOOK_SECRET",
            "parameter": {
              "source": "header",
              "name": "X-Hub-Signature-256"
            }
          }
        }
      ]
    }
  }
]
