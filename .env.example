# Server env
# Host interface used by the admin HTTP server.
ADMIN_HOST=0.0.0.0
# TCP port used by the admin HTTP server.
ADMIN_PORT=3005
# Plain-text admin password used for local single-user access.
ADMIN_PASSWORD=change-me
# Secret used to sign admin session cookies; use a long random value outside development.
SESSION_SECRET=change-me-to-a-long-random-string
# SQLite database file path used as the main application datastore.
DATABASE_URL=./redqueenx.sqlite
# Log file path continuously updated with current runtime activity.
CURRENT_SESSION_FILE=./runtime/current-session.log
# JSON report read by the admin VPS health panel in Docker mode.
VPS_HEALTH_REPORT_PATH=./runtime/vps-health.json
# Caddy JSON access log used for HTTP scan/status metrics and fail2ban.
REDQUEENX_CADDY_ACCESS_LOG=./runtime/caddy-logs/access.log
# Persistent security IP history used to survive fail2ban/iptables counter resets.
REDQUEENX_SECURITY_HISTORY_PATH=./runtime/vps-security-history.json
# Append-only security IP events log.
REDQUEENX_SECURITY_HISTORY_EVENTS_PATH=./runtime/vps-security-events.jsonl
# File mode for VPS health/history reports. 0644 lets the Docker admin user read host-collected reports.
REDQUEENX_HEALTH_FILE_MODE=0644
# Maximum number of RSS feeds to process when RSS fallback code is enabled.
RSS_FALLBACK_FEED_LIMIT=25
# Search Reddit for normal, non-@user keywords after each X keyword search.
REDDIT_CRAWL_ENABLED=false
# User-Agent sent to Reddit's public JSON endpoint.
REDDIT_CRAWL_USER_AGENT=RedqueenX/0.1.0
# Comma-separated subreddits to search. Leave empty to search all Reddit.
REDDIT_CRAWL_SUBREDDITS=cybersecurity,netsec,blueteamsec,osint,privacy
# Maximum Reddit posts saved for one keyword.
REDDIT_CRAWL_LIMIT_PER_KEYWORD=10
# Reddit search sort mode: relevance, hot, top, new, or comments.
REDDIT_CRAWL_SORT=relevance
# Reddit search time range: hour, day, week, month, year, or all.
REDDIT_CRAWL_TIME_RANGE=month
# Minimum Reddit post score required before saving it to Timeline.
REDDIT_CRAWL_MIN_SCORE=2

# Without API env
# Enable the future browser-based search mode without the X API.
SEARCH_WITHOUT_API_ENABLED=false
# Isolation backend for without-API browser work: host_netns keeps the existing helper flow, docker_vpn uses Docker services.
SEARCH_WITHOUT_API_ISOLATION=host_netns
# Persistent browser profile directory for the search-without-API browser session.
SEARCH_WITHOUT_API_PROFILE_DIR=./runtime/playwright-profile
# Initial URL opened by the browser-based search mode.
SEARCH_WITHOUT_API_START_URL=https://x.com/search
# Legacy maximum number of result-page scrolls for browser-based search.
SEARCH_WITHOUT_API_MAX_SCROLLS=20
# Delay in milliseconds between browser scroll actions.
SEARCH_WITHOUT_API_SCROLL_DELAY_MS=1200
# Minimum random pause in milliseconds after each Playwright result scroll.
SEARCH_WITHOUT_API_SCROLL_DELAY_MIN_MS=5000
# Maximum random pause in milliseconds after each Playwright result scroll.
SEARCH_WITHOUT_API_SCROLL_DELAY_MAX_MS=12000
# Run the browser without a visible window when set to true.
SEARCH_WITHOUT_API_HEADLESS=false
# Show the browser window on a local Wayland/X11 desktop so searches can be watched live.
SEARCH_WITHOUT_API_SHOW_BROWSER_LOCAL=false
# Minimum random delay in milliseconds between typed characters.
SEARCH_WITHOUT_API_KEY_DELAY_MIN_MS=500
# Maximum random delay in milliseconds between typed characters.
SEARCH_WITHOUT_API_KEY_DELAY_MAX_MS=5000
# Minimum random delay in seconds between browser search requests.
SEARCH_WITHOUT_API_SEARCH_DELAY_MIN_SECONDS=5
# Maximum random delay in seconds between browser search requests.
SEARCH_WITHOUT_API_SEARCH_DELAY_MAX_SECONDS=120
# Maximum number of keywords searched in one browser session. Use 0 to search every eligible keyword.
SEARCH_WITHOUT_API_SESSION_KEYWORD_LIMIT=50
# Choose a random keyword count between 1 and SEARCH_WITHOUT_API_SESSION_KEYWORD_LIMIT for each session.
SEARCH_WITHOUT_API_SESSION_KEYWORD_LIMIT_RANDOM=false
# Shuffle eligible keywords before applying the session limit.
SEARCH_WITHOUT_API_RANDOMIZE_KEYWORD_ORDER=false
# Target percentage of @user keywords in one session. The planner fills from remaining keywords when the target ratio cannot be met.
SEARCH_WITHOUT_API_USER_KEYWORD_PERCENT=100
# Deprecated compatibility value. Runtime pause threshold is now half of loaded session keywords.
SEARCH_WITHOUT_API_REQUESTS_BEFORE_PAUSE_MIN=10
# Deprecated compatibility value. Runtime pause threshold is now half of loaded session keywords.
SEARCH_WITHOUT_API_REQUESTS_BEFORE_PAUSE_MAX=180
# Minimum random pause duration in minutes for browser-based search.
SEARCH_WITHOUT_API_PAUSE_MIN_MINUTES=15
# Maximum random pause duration in minutes for browser-based search.
SEARCH_WITHOUT_API_PAUSE_MAX_MINUTES=120
# Minimum random number of scrolls performed on a result page.
SEARCH_WITHOUT_API_SCROLLS_MIN=0
# Maximum random number of scrolls performed on a result page.
SEARCH_WITHOUT_API_SCROLLS_MAX=23
# Minimum random time in seconds to hover over a tweet.
SEARCH_WITHOUT_API_TWEET_HOVER_MIN_SECONDS=1
# Maximum random time in seconds to hover over a tweet.
SEARCH_WITHOUT_API_TWEET_HOVER_MAX_SECONDS=15
# Mouse movement style used by browser-based search: smooth1, smooth2, or smooth3.
SEARCH_WITHOUT_API_MOUSE_PROFILE=smooth1
# Save full Playwright page text snapshots during normal runs. Smoke tests always save snapshots.
SEARCH_WITHOUT_API_SAVE_SNAPSHOTS=false
# Allow the VPN namespace worker to download X media into a local cache.
SEARCH_WITHOUT_API_MEDIA_CACHE_ENABLED=false
# Directory used for temporary VPN-downloaded media files.
SEARCH_WITHOUT_API_MEDIA_CACHE_DIR=./runtime/media-cache
# Number of hours cached media remains usable before it expires. Use 0 for no expiration.
SEARCH_WITHOUT_API_MEDIA_CACHE_TTL_HOURS=24
# Maximum total cache size in megabytes; oldest files are removed first. Use 0 for unlimited size.
SEARCH_WITHOUT_API_MEDIA_CACHE_MAX_MB=256
# Maximum size in megabytes accepted for one image or video.
SEARCH_WITHOUT_API_MEDIA_CACHE_MAX_FILE_MB=15
# Minimum delay in milliseconds between two media download requests.
SEARCH_WITHOUT_API_MEDIA_CACHE_FETCH_DELAY_MIN_MS=800
# Maximum delay in milliseconds between two media download requests.
SEARCH_WITHOUT_API_MEDIA_CACHE_FETCH_DELAY_MAX_MS=3000
# Default number of tweets shown per page on Timeline and Rejected Timeline.
TIMELINE_DEFAULT_PAGE_SIZE=50
# Keyword batch multiplier for one Start run. 0 = one normal batch, 1 = double, 3 = triple.
RUN_CHAIN_COUNT=0
# Remove @keywords when the latest visible tweet from that user is older than this many days.
STALE_KEYWORD_USER_MAX_AGE_DAYS=90
# Automatically ignore X session alerts raised by Keyword users cleanup.
STALE_KEYWORD_USER_AUTO_IGNORE_ALERT=false
# Maximum restart attempts after X session alerts during Keyword users cleanup.
STALE_KEYWORD_USER_MAX_RETRIES=3
# Save DOM-visible Playwright tweets so rejected items can be reviewed in Rejected Timeline.
RAW_TIMELINE_ENABLED=true
# Enable only for temporary docker compose run x-login sessions launched from an SSH X-forwarded host shell.
DOCKER_X11_FORWARD_ENABLED=false
# Host or bridge IP that the x-login container uses to reach SSH X forwarding.
DOCKER_X11_HOST=
# TCP port for SSH X forwarding. Display :10 usually maps to 6010.
DOCKER_X11_PORT=6010
# Temporary xauth file generated by ops/docker/x11-bridge.sh and mounted into x-login.
DOCKER_XAUTHORITY=/tmp/redqueenx-docker.xauth
# Optional UID/GID used by Docker services for runtime file ownership. Prefer exporting these from the shell.
# REDQUEENX_UID=1000
# REDQUEENX_GID=1000
# Linux network namespace name used by the browser crawler.
VPN_NETNS_NAME=redqueenx-vpn
# Host interface used before OpenVPN connects; leave empty for auto-detection.
VPN_HOST_IFACE=
# Private IPv4 subnet used between the host and the namespace.
VPN_NETNS_CIDR=10.200.0.0/24
# Host-side veth IPv4 address for the namespace bridge.
VPN_NETNS_HOST_IP=10.200.0.1
# Namespace-side veth IPv4 address for the browser crawler.
VPN_NETNS_GUEST_IP=10.200.0.2
# OpenVPN server hostname or IPv4 address.
VPN_REMOTE_HOST=
# OpenVPN server port.
VPN_REMOTE_PORT=1194
# OpenVPN transport protocol: udp or tcp.
VPN_REMOTE_PROTO=udp
# OpenVPN client config path. Provider .ovpn files and .conf copies are both valid.
VPN_CONFIG=./ops/vpn/custom.conf
# Prompt and start OpenVPN automatically when a netns command detects that the namespace or tunnel is missing.
VPN_NETNS_AUTOSTART=true
# Maximum time a netns command waits for an auto-started VPN tunnel.
VPN_NETNS_AUTOSTART_TIMEOUT_SECONDS=90
# Log file used when a netns command starts OpenVPN in the background.
VPN_NETNS_AUTOSTART_LOG=./runtime/netns-openvpn-autostart.log
# PID file used when a netns command starts OpenVPN in the background.
VPN_NETNS_AUTOSTART_PID_FILE=./runtime/netns-openvpn-autostart.pid
# Compare namespace/browser IPv4 with the host public IPv4 detected before entering the namespace.
VPN_CHECK_HOST_IPV4_LEAK=true
# Run IPv6 leak checks. Keep true to detect IPv6 leaks by default.
VPN_CHECK_IPV6=true
# Fail diagnostics when required network checks cannot be verified.
VPN_DIAGNOSTIC_STRICT=true
# Run browser-level VPN diagnostics through Playwright.
VPN_DIAGNOSTIC_PLAYWRIGHT=true
# Skip the X login API/CORS precheck before opening Chrome; keep false unless manually troubleshooting.
X_LOGIN_SKIP_NETWORK_PRECHECK=false
# Optional system Chromium path used by Playwright.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# Launch Chromium with --no-sandbox when true.
PLAYWRIGHT_DISABLE_SANDBOX=true

# X API env
# Enable X API search mode when set to true.
X_API_ENABLED=true
# Maximum X search calls allowed per rate-limit window.
X_SEARCH_API_CALL_LIMIT=180
# Length of the local X search rate-limit window in minutes.
X_SEARCH_API_WINDOW_MINUTES=15
# Estimated remaining X API credit in USD.
X_API_CREDIT_USD=0
# Total X API credit already consumed in USD.
X_API_TOTAL_CREDIT_USED_USD=0
# Maximum estimated X API spend allowed per day.
X_DAILY_SPEND_LIMIT_USD=1
# Maximum estimated X API spend allowed for a single run.
X_RUN_SPEND_LIMIT_USD=2
# Maximum number of X search calls allowed per day; 0 disables search calls.
X_MAX_SEARCHES_PER_DAY=25
# Maximum number of X posts allowed to be read per day; 0 disables post reads.
X_MAX_POSTS_READ_PER_DAY=250
# Maximum number of X count-first calls allowed per day.
X_MAX_COUNT_CALLS_PER_DAY=500
# Number of keywords grouped into each X query.
X_KEYWORDS_PER_QUERY=5
# Run a count-first request before fetching tweets when set to true.
X_COUNT_FIRST_MODE=true
# Estimated USD cost for reading one X post.
X_COST_POST_READ_USD=0.005
# Estimated USD cost for reading one X user.
X_COST_USER_READ_USD=0.010
# Estimated USD cost for reading one X media object.
X_COST_MEDIA_READ_USD=0.005
# Estimated USD cost for one manual X action such as like or retweet.
X_COST_USER_INTERACTION_USD=0.015
# Estimated USD cost for one X count-first request.
X_COST_COUNT_CALL_USD=0
# X developer Consumer Key, also called API Key.
X_API_KEY=
# X developer Consumer Secret, also called API Secret.
X_API_SECRET=
# X bearer token used for read/search API access.
X_BEARER_TOKEN=
# OAuth 2.0 client ID from the X developer portal.
X_CLIENT_ID=
# OAuth 2.0 client secret from the X developer portal.
X_CLIENT_SECRET=
# OAuth 1.0a access token used for write actions when X writing is enabled.
X_ACCESS_TOKEN=
# OAuth 1.0a access token secret used for write actions when X writing is enabled.
X_ACCESS_SECRET=
# Enable write actions on X, such as favorites and retweets, when set to true.
ENABLE_X_WRITE=false
